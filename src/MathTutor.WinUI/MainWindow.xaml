<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="MathTutor.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Tutor Matemático Accesible - Aprendizaje Lúdico Inclusivo"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid"
          Background="{ThemeResource AppBackgroundBrush}"
          RequestedTheme="Light">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="F1" Invoked="OnHelpAccelerator" />
            <KeyboardAccelerator Key="F2" Invoked="OnSoundsAccelerator" />
            <KeyboardAccelerator Key="F3" Invoked="OnContrastAccelerator" />
            <KeyboardAccelerator Key="F4" Invoked="OnFontAccelerator" />
            <KeyboardAccelerator Key="F5" Invoked="OnProfileAccelerator" />
            <KeyboardAccelerator Key="F6" Invoked="OnMapAccelerator" />
            <KeyboardAccelerator Key="Escape" Invoked="OnEscapeAccelerator" />
        </Grid.KeyboardAccelerators>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{ThemeResource AppSurfaceBrush}"
                BorderBrush="{ThemeResource AppBorderBrush}"
                BorderThickness="0,0,0,2"
                Padding="16,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="🦉"
                               FontSize="30"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"
                               AutomationProperties.AccessibilityView="Raw" />
                    <TextBlock Text="MathTutor Accesible"
                               FontSize="{ThemeResource AppSubHeaderFontSize}"
                               FontWeight="Bold"
                               Foreground="{ThemeResource AppAccentBrush}"
                               VerticalAlignment="Center"
                               AutomationProperties.HeadingLevel="Level1" />
                </StackPanel>

                <CommandBar x:Name="TopCommandBar"
                            Grid.Column="1"
                            Background="Transparent"
                            AutomationProperties.Name="Navegación y accesibilidad"
                            DefaultLabelPosition="Right"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            IsDynamicOverflowEnabled="True">
                    <AppBarButton Label="Menú (Esc)" Click="BtnNavMenu_Click">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE80F;" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton Label="Mapa (F6)" Click="BtnNavMap_Click">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE707;" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton Label="Perfil (F5)" Click="BtnNavProfile_Click">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE77B;" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton Label="Contraste (F3)" Click="BtnToggleContrast_Click">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE790;" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton Label="Letra (F4)" Click="BtnToggleFont_Click">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE8D2;" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton Label="Sonidos (F2)" Click="BtnToggleSpeech_Click">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE767;" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton Label="Repetir (F1)" Click="BtnHelpVoice_Click">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE897;" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                </CommandBar>

                <Border Grid.Column="2"
                        Background="{ThemeResource AppCardBrush}"
                        BorderBrush="{ThemeResource AppBorderBrush}"
                        BorderThickness="2"
                        CornerRadius="8"
                        Padding="10,6"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⭐ "
                                   FontSize="18"
                                   VerticalAlignment="Center"
                                   AutomationProperties.AccessibilityView="Raw" />
                        <TextBlock x:Name="TxtTopStars"
                                   Text="0"
                                   FontSize="{ThemeResource AppBaseFontSize}"
                                   FontWeight="Bold"
                                   Foreground="{ThemeResource AppTextPrimaryBrush}"
                                   VerticalAlignment="Center"
                                   AutomationProperties.Name="0 estrellas" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Frame x:Name="RootFrame" Grid.Row="1" />

        <Border Grid.Row="2"
                Background="{ThemeResource AppCardBrush}"
                BorderBrush="{ThemeResource AppBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="💬 " FontSize="16" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
                <TextBlock Grid.Column="1"
                           x:Name="TxtLiveAnnouncement"
                           Text="Listo para aprender jugando."
                           FontSize="{ThemeResource AppBaseFontSize}"
                           Foreground="{ThemeResource AppTextSecondaryBrush}"
                           TextTrimming="CharacterEllipsis"
                           TextWrapping="NoWrap"
                           VerticalAlignment="Center"
                           AutomationProperties.Name="Listo para aprender jugando." />
            </Grid>
        </Border>
    </Grid>
</Window>
