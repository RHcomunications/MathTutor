<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="MathTutor.WinUI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MathTutor.WinUI">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Paleta base accesible predeterminada -->
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F8F9FF"/>
            <SolidColorBrush x:Key="AppSurfaceBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="AppCardBrush" Color="#F0F3FA"/>
            <SolidColorBrush x:Key="AppTextPrimaryBrush" Color="#14192D"/>
            <SolidColorBrush x:Key="AppTextSecondaryBrush" Color="#3C465F"/>
            <SolidColorBrush x:Key="AppAccentBrush" Color="#5A3CDC"/>
            <SolidColorBrush x:Key="AppFocusBorderBrush" Color="#FF7800"/>
            <SolidColorBrush x:Key="AppBorderBrush" Color="#6E7D9B"/>
            <SolidColorBrush x:Key="AppSuccessBrush" Color="#0B6B36"/>
            <SolidColorBrush x:Key="AppOnAccentBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="AppOnSuccessBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="AppErrorBrush" Color="#B00020"/>

            <!-- Indicador de foco visible WCAG 2.4.7 y 2.4.11 -->
            <SolidColorBrush x:Key="FocusVisualPrimaryBrush" Color="#000000"/>
            <SolidColorBrush x:Key="FocusVisualSecondaryBrush" Color="#FFFFFF"/>
            <Thickness x:Key="FocusVisualMargin">-2</Thickness>

            <!-- Escala de tipografia adaptable -->
            <x:Double x:Key="AppBaseFontSize">18</x:Double>
            <x:Double x:Key="AppSubHeaderFontSize">22</x:Double>
            <x:Double x:Key="AppHeaderFontSize">28</x:Double>
            <x:Double x:Key="AppTitleFontSize">36</x:Double>

            <!-- Estilo accesible para Botones de Accion -->
            <Style x:Key="AccessibleActionButton" TargetType="Button">
                <Setter Property="Background" Value="{ThemeResource AppAccentBrush}"/>
                <Setter Property="Foreground" Value="{ThemeResource AppOnAccentBrush}"/>
                <Setter Property="FontSize" Value="{ThemeResource AppBaseFontSize}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Padding" Value="16,12"/>
                <Setter Property="MinHeight" Value="52"/>
                <Setter Property="MinWidth" Value="120"/>
                <Setter Property="BorderThickness" Value="2"/>
                <Setter Property="BorderBrush" Value="{ThemeResource AppBorderBrush}"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="UseSystemFocusVisuals" Value="True"/>
            </Style>

            <!-- Estilo accesible para Botones de Opcion del Minijuego -->
            <Style x:Key="AccessibleGameOptionButton" TargetType="Button">
                <Setter Property="Background" Value="{ThemeResource AppSurfaceBrush}"/>
                <Setter Property="Foreground" Value="{ThemeResource AppTextPrimaryBrush}"/>
                <Setter Property="FontSize" Value="{ThemeResource AppHeaderFontSize}"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Padding" Value="24,18"/>
                <Setter Property="MinHeight" Value="75"/>
                <Setter Property="MinWidth" Value="140"/>
                <Setter Property="BorderThickness" Value="3"/>
                <Setter Property="BorderBrush" Value="{ThemeResource AppBorderBrush}"/>
                <Setter Property="CornerRadius" Value="12"/>
                <Setter Property="UseSystemFocusVisuals" Value="True"/>
            </Style>

            <!-- Estilo para Tarjetas Contenedoras -->
            <Style x:Key="AccessibleCard" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource AppCardBrush}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource AppBorderBrush}"/>
                <Setter Property="BorderThickness" Value="2"/>
                <Setter Property="CornerRadius" Value="14"/>
                <Setter Property="Padding" Value="20"/>
            </Style>

            <!-- Estilo para Bloques de Texto Explorables con Cursor del Lector de Pantalla -->
            <Style x:Key="AccessibleReadOnlyTextBox" TargetType="TextBox">
                <Setter Property="IsReadOnly" Value="True"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="2"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="AcceptsReturn" Value="True"/>
                <Setter Property="IsSpellCheckEnabled" Value="False"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
