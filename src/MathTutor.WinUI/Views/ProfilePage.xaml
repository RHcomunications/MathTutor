<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MathTutor.WinUI.Views.ProfilePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Border Margin="24" Style="{StaticResource AccessibleCard}" MaxWidth="850" HorizontalAlignment="Center">
            <StackPanel Spacing="8">
                <Border Background="{ThemeResource AppSurfaceBrush}"
                        BorderBrush="{ThemeResource AppAccentBrush}"
                        BorderThickness="0,0,0,4"
                        CornerRadius="8"
                        Padding="16"
                        Margin="0,0,0,20">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="16">
                        <TextBlock Text="🦉" FontSize="48" VerticalAlignment="Center" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw" />
                        <StackPanel VerticalAlignment="Center" Spacing="4">
                            <TextBlock Text="¡Bienvenido a la Aventura de las Matemáticas!"
                                       FontSize="{ThemeResource AppHeaderFontSize}"
                                       FontWeight="Bold"
                                       Foreground="{ThemeResource AppTextPrimaryBrush}"
                                       TextWrapping="Wrap"
                                       AutomationProperties.HeadingLevel="Level1" />
                            <TextBlock Text="Caracterización del Alumno y Configuración de Accesibilidad"
                                       FontSize="{ThemeResource AppBaseFontSize}"
                                       Foreground="{ThemeResource AppTextSecondaryBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TextBlock Text="1. ¿Cómo te llamas o cómo quieres que te llame Cosmo?"
                           FontSize="{ThemeResource AppBaseFontSize}"
                           FontWeight="Bold"
                           Foreground="{ThemeResource AppTextPrimaryBrush}"
                           Margin="0,8,0,4"
                           TextWrapping="Wrap"
                           AutomationProperties.HeadingLevel="Level2" />
                <TextBox x:Name="TxtName"
                         Text="Aventurero Matemático"
                         FontSize="{ThemeResource AppBaseFontSize}"
                         Padding="12,8"
                         MinHeight="48"
                         AutomationProperties.Name="Nombre o apodo del alumno"
                         AutomationProperties.HelpText="Escribe tu nombre para personalizar los juegos"
                         BorderThickness="2"
                         BorderBrush="{ThemeResource AppBorderBrush}"
                         Margin="0,0,0,8"
                         GotFocus="Control_GotFocus" />

                <Grid Margin="0,0,0,16" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Text="2. Edad del Alumno"
                                   FontSize="{ThemeResource AppBaseFontSize}"
                                   FontWeight="Bold"
                                   Foreground="{ThemeResource AppTextPrimaryBrush}"
                                   TextWrapping="Wrap"
                                   AutomationProperties.HeadingLevel="Level2" />
                        <ComboBox x:Name="CmbAge"
                                  FontSize="{ThemeResource AppBaseFontSize}"
                                  MinHeight="48"
                                  Padding="10,6"
                                  HorizontalAlignment="Stretch"
                                  AutomationProperties.Name="Edad del alumno en años"
                                  SelectionChanged="CmbAge_SelectionChanged"
                                  GotFocus="Control_GotFocus" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock Text="3. Nivel Escolar Inicial"
                                   FontSize="{ThemeResource AppBaseFontSize}"
                                   FontWeight="Bold"
                                   Foreground="{ThemeResource AppTextPrimaryBrush}"
                                   TextWrapping="Wrap"
                                   AutomationProperties.HeadingLevel="Level2" />
                        <ComboBox x:Name="CmbAcademicLevel"
                                  FontSize="{ThemeResource AppBaseFontSize}"
                                  MinHeight="48"
                                  Padding="10,6"
                                  HorizontalAlignment="Stretch"
                                  AutomationProperties.Name="Nivel escolar inicial"
                                  SelectionChanged="CmbAcademicLevel_SelectionChanged"
                                  GotFocus="Control_GotFocus" />
                    </StackPanel>
                </Grid>

                <StackPanel Margin="0,0,0,16" Spacing="4">
                    <TextBlock Text="4. País y Moneda (Adaptación Cultural de Ejemplos)"
                               FontSize="{ThemeResource AppBaseFontSize}"
                               FontWeight="Bold"
                               Foreground="{ThemeResource AppTextPrimaryBrush}"
                               TextWrapping="Wrap"
                               AutomationProperties.HeadingLevel="Level2" />
                    <ComboBox x:Name="CmbRegion"
                              FontSize="{ThemeResource AppBaseFontSize}"
                              MinHeight="48"
                              Padding="10,6"
                              HorizontalAlignment="Stretch"
                              AutomationProperties.Name="País y adaptación cultural de moneda y vocabulario"
                              SelectionChanged="CmbRegion_SelectionChanged"
                              GotFocus="Control_GotFocus" />
                </StackPanel>

                <Border Background="{ThemeResource AppSurfaceBrush}"
                        BorderBrush="{ThemeResource AppBorderBrush}"
                        BorderThickness="2"
                        CornerRadius="8"
                        Padding="16"
                        Margin="0,8,0,20">
                    <StackPanel Spacing="8">
                        <TextBlock Text="5. Caracterización de Discapacidad o Condición del Alumno"
                                   FontSize="{ThemeResource AppSubHeaderFontSize}"
                                   FontWeight="Bold"
                                   Foreground="{ThemeResource AppAccentBrush}"
                                   TextWrapping="Wrap"
                                   AutomationProperties.HeadingLevel="Level2" />
                        <TextBlock Text="El tutor adaptará automáticamente el lenguaje, los estímulos visuales, la voz y la dificultad según esta selección."
                                   FontSize="{ThemeResource AppBaseFontSize}"
                                   Foreground="{ThemeResource AppTextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,4" />

                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="Condición o Discapacidad (Selección múltiple / Comorbilidad):"
                                           FontSize="{ThemeResource AppBaseFontSize}"
                                           FontWeight="SemiBold"
                                           Foreground="{ThemeResource AppTextPrimaryBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,4"
                                           AutomationProperties.HeadingLevel="Level3" />
                                <CheckBox x:Name="ChkDisabilityVisual"
                                          Content="👁️ Discapacidad Visual (Ceguera o Baja Visión)"
                                          FontSize="{ThemeResource AppBaseFontSize}"
                                          Margin="0,3"
                                          AutomationProperties.Name="Discapacidad Visual, Ceguera o Baja Visión"
                                          Click="ChkDisability_Changed"
                                          GotFocus="Control_GotFocus" />
                                <CheckBox x:Name="ChkDisabilityHearing"
                                          Content="👂 Discapacidad Auditiva (Hipoacusia o Sordera)"
                                          FontSize="{ThemeResource AppBaseFontSize}"
                                          Margin="0,3"
                                          AutomationProperties.Name="Discapacidad Auditiva, Hipoacusia o Sordera"
                                          Click="ChkDisability_Changed"
                                          GotFocus="Control_GotFocus" />
                                <CheckBox x:Name="ChkDisabilityMotor"
                                          Content="🖐️ Discapacidad Motriz (Dificultad motora fina)"
                                          FontSize="{ThemeResource AppBaseFontSize}"
                                          Margin="0,3"
                                          AutomationProperties.Name="Discapacidad Motriz, Dificultad motora fina"
                                          Click="ChkDisability_Changed"
                                          GotFocus="Control_GotFocus" />
                                <CheckBox x:Name="ChkDisabilityIntellectual"
                                          Content="🧠 Discapacidad Intelectual / Cognitiva"
                                          FontSize="{ThemeResource AppBaseFontSize}"
                                          Margin="0,3"
                                          AutomationProperties.Name="Discapacidad Intelectual o Cognitiva"
                                          Click="ChkDisability_Changed"
                                          GotFocus="Control_GotFocus" />
                                <CheckBox x:Name="ChkDisabilityNeurodivergent"
                                          Content="🌈 Neurodivergente (TDAH o Espectro Autista)"
                                          FontSize="{ThemeResource AppBaseFontSize}"
                                          Margin="0,3"
                                          AutomationProperties.Name="Neurodivergente, TDAH o Espectro Autista"
                                          Click="ChkDisability_Changed"
                                          GotFocus="Control_GotFocus" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Text="Grado / Severidad:"
                                           FontSize="{ThemeResource AppBaseFontSize}"
                                           FontWeight="SemiBold"
                                           Foreground="{ThemeResource AppTextPrimaryBrush}"
                                           TextWrapping="Wrap"
                                           AutomationProperties.HeadingLevel="Level3" />
                                <ComboBox x:Name="CmbDisabilitySeverity"
                                          FontSize="{ThemeResource AppBaseFontSize}"
                                          MinHeight="48"
                                          Padding="10,6"
                                          HorizontalAlignment="Stretch"
                                          AutomationProperties.Name="Grado o severidad de la discapacidad"
                                          SelectionChanged="CmbDisabilitySeverity_SelectionChanged"
                                          GotFocus="Control_GotFocus" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Opciones Adaptativas Activas:"
                                   FontSize="{ThemeResource AppBaseFontSize}"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource AppTextPrimaryBrush}"
                                   Margin="0,8,0,2"
                                   TextWrapping="Wrap"
                                   AutomationProperties.HeadingLevel="Level3" />

                        <CheckBox x:Name="ChkInternalAudio"
                                  Content="Audio Interno del Juego: efectos y pistas sonoras (El lector de pantalla NVDA, JAWS o Narrador permanece siempre activo)"
                                  FontSize="{ThemeResource AppBaseFontSize}"
                                  Margin="0,4"
                                  AutomationProperties.Name="Audio interno del juego, efectos y pistas sonoras. El lector de pantalla del sistema permanece siempre activo"
                                  Checked="ChkInternalAudio_Changed"
                                  Unchecked="ChkInternalAudio_Changed"
                                  GotFocus="Control_GotFocus" />

                        <CheckBox x:Name="ChkAudioCues"
                                  Content="Pistas Sonoras Musicales y de Orientación (Conteo Armónico)"
                                  FontSize="{ThemeResource AppBaseFontSize}"
                                  Margin="0,4"
                                  AutomationProperties.Name="Pistas Sonoras Musicales y de Orientación"
                                  Checked="ChkAudioCues_Changed"
                                  Unchecked="ChkAudioCues_Changed"
                                  GotFocus="Control_GotFocus" />

                        <CheckBox x:Name="ChkSimplifyLanguage"
                                  Content="Simplificar Lenguaje y Reducir Opciones (Discapacidad Intelectual / Menor Carga Cognitiva)"
                                  FontSize="{ThemeResource AppBaseFontSize}"
                                  Margin="0,4"
                                  AutomationProperties.Name="Simplificar Lenguaje y Reducir Opciones"
                                  Checked="ChkSimplifyLanguage_Changed"
                                  Unchecked="ChkSimplifyLanguage_Changed"
                                  GotFocus="Control_GotFocus" />
                    </StackPanel>
                </Border>

                <Grid Margin="0,0,0,24" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Text="6. Esquema de Contraste (WCAG)"
                                   FontSize="{ThemeResource AppBaseFontSize}"
                                   FontWeight="Bold"
                                   Foreground="{ThemeResource AppTextPrimaryBrush}"
                                   TextWrapping="Wrap"
                                   AutomationProperties.HeadingLevel="Level2" />
                        <ComboBox x:Name="CmbTheme"
                                  FontSize="{ThemeResource AppBaseFontSize}"
                                  MinHeight="48"
                                  Padding="10,6"
                                  HorizontalAlignment="Stretch"
                                  AutomationProperties.Name="Esquema de contraste accesible"
                                  SelectionChanged="CmbTheme_SelectionChanged"
                                  GotFocus="Control_GotFocus" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock Text="7. Tamaño de Letra"
                                   FontSize="{ThemeResource AppBaseFontSize}"
                                   FontWeight="Bold"
                                   Foreground="{ThemeResource AppTextPrimaryBrush}"
                                   TextWrapping="Wrap"
                                   AutomationProperties.HeadingLevel="Level2" />
                        <ComboBox x:Name="CmbFontSize"
                                  FontSize="{ThemeResource AppBaseFontSize}"
                                  MinHeight="48"
                                  Padding="10,6"
                                  HorizontalAlignment="Stretch"
                                  AutomationProperties.Name="Tamaño de letra del sistema"
                                  SelectionChanged="CmbFontSize_SelectionChanged"
                                  GotFocus="Control_GotFocus" />
                    </StackPanel>
                </Grid>

                <Button x:Name="BtnSaveAndStart"
                        Content="⭐ ¡Guardar Caracterización y Comenzar la Aventura! ⭐"
                        Style="{StaticResource AccessibleActionButton}"
                        FontSize="{ThemeResource AppHeaderFontSize}"
                        MinHeight="64"
                        AutomationProperties.Name="Guardar perfil y comenzar la aventura matemática"
                        AutomationProperties.HelpText="Presiona Enter o Espacio para guardar tu perfil e ir al menú de misiones"
                        Click="BtnSaveAndStart_Click"
                        GotFocus="Control_GotFocus" />

                <Button x:Name="BtnCancel"
                        Content="⬅ Volver al Menú sin Guardar"
                        Style="{StaticResource AccessibleActionButton}"
                        Background="{ThemeResource AppSurfaceBrush}"
                        Foreground="{ThemeResource AppTextPrimaryBrush}"
                        FontSize="{ThemeResource AppBaseFontSize}"
                        MinHeight="56"
                        Margin="0,12,0,0"
                        Visibility="Collapsed"
                        AutomationProperties.Name="Volver al menú sin guardar los cambios"
                        AutomationProperties.HelpText="Descarta los cambios de esta pantalla y regresa al menú de misiones"
                        Click="BtnCancel_Click"
                        GotFocus="Control_GotFocus" />
            </StackPanel>
        </Border>
    </ScrollViewer>
</Page>
