<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MathTutor.WinUI.Views.ProfilePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Border Margin="24" Style="{StaticResource AccessibleCard}" MaxWidth="850" HorizontalAlignment="Center">
            <StackPanel Spacing="8">
                <Border Background="{ThemeResource AppSurfaceBrush}"
                        BorderBrush="{ThemeResource AppAccentBrush}"
                        BorderThickness="0,0,0,4"
                        CornerRadius="8"
                        Padding="16"
                        Margin="0,0,0,20">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="16">
                        <TextBlock Text="🦉" FontSize="48" VerticalAlignment="Center" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw" />
                        <StackPanel VerticalAlignment="Center" Spacing="4">
                            <TextBlock Text="¡Bienvenido a la Aventura de las Matemáticas!"
                                       FontSize="{ThemeResource AppHeaderFontSize}"
                                       FontWeight="Bold"
                                       Foreground="{ThemeResource AppTextPrimaryBrush}"
                                       TextWrapping="Wrap"
                                       AutomationProperties.HeadingLevel="Level1" />
                            <TextBlock Text="Caracterización del Alumno y Configuración de Accesibilidad"
                                       FontSize="{ThemeResource AppBaseFontSize}"
                                       Foreground="{ThemeResource AppTextSecondaryBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TextBlock Text="1. ¿Cómo te llamas o cómo quieres que te llame Cosmo?"
                           FontSize="{ThemeResource AppBaseFontSize}"
                           FontWeight="Bold"
                           Foreground="{ThemeResource AppTextPrimaryBrush}"
                           Margin="0,8,0,4"
                           TextWrapping="Wrap"
                           AutomationProperties.HeadingLevel="Level2" />
                <TextBox x:Name="TxtName"
                         Text="Aventurero Matemático"
                         FontSize="{ThemeResource AppBaseFontSize}"
                         Padding="12,8"
                         MinHeight="48"
                         AutomationProperties.Name="Nombre o apodo del alumno"
                         AutomationProperties.HelpText="Escribe tu nombre para personalizar los juegos"
                         BorderThickness="2"
                         BorderBrush="{ThemeResource AppBorderBrush}"
                         Margin="0,0,0,8"
                         GotFocus="Control_GotFocus" />

                <Grid Margin="0,0,0,16" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Text="2. Edad del Alumno"
                                   FontSize="{ThemeResource AppBaseFontSize}"
                                   FontWeight="Bold"
                                   Foreground="{ThemeResource AppTextPrimaryBrush}"
                                   TextWrapping="Wrap"
                                   AutomationProperties.HeadingLevel="Level2" />
                        <ComboBox x:Name="CmbAge"
                                  FontSize="{ThemeResource AppBaseFontSize}"
                                  MinHeight="48"
                                  Padding="10,6"
                                  HorizontalAlignment="Stretch"
                                  AutomationProperties.Name="Edad del alumno en años"
                                  SelectionChanged="CmbAge_SelectionChanged"
                                  GotFocus="Control_GotFocus" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock Text="3. Nivel Escolar Inicial"
                                   FontSize="{ThemeResource AppBaseFontSize}"
                                   FontWeight="Bold"
                                   Foreground="{ThemeResource AppTextPrimaryBrush}"
                                   TextWrapping="Wrap"
                                   AutomationProperties.HeadingLevel="Level2" />
                        <ComboBox x:Name="CmbAcademicLevel"
                                  FontSize="{ThemeResource AppBaseFontSize}"
                                  MinHeight="48"
                                  Padding="10,6"
                                  HorizontalAlignment="Stretch"
                                  AutomationProperties.Name="Nivel escolar inicial"
                                  SelectionChanged="CmbAcademicLevel_SelectionChanged"
                                  GotFocus="Control_GotFocus" />
                    </StackPanel>
                </Grid>

                <StackPanel Margin="0,0,0,16" Spacing="4">
                    <TextBlock Text="4. País y Moneda (Adaptación Cultural de Ejemplos)"
                               FontSize="{ThemeResource AppBaseFontSize}"
                               FontWeight="Bold"
                               Foreground="{ThemeResource AppTextPrimaryBrush}"
                               TextWrapping="Wrap"
                               AutomationProperties.HeadingLevel="Level2" />
                    <ComboBox x:Name="CmbRegion"
                              FontSize="{ThemeResource AppBaseFontSize}"
                              MinHeight="48"
                              Padding="10,6"
                              HorizontalAlignment="Stretch"
                              AutomationProperties.Name="País y adaptación cultural de moneda y vocabulario"
                              SelectionChanged="CmbRegion_SelectionChanged"
                              GotFocus="Control_GotFocus" />
                </StackPanel>

                <Border Background="{ThemeResource AppSurfaceBrush}"
                        BorderBrush="{ThemeResource AppBorderBrush}"
                        BorderThickness="2"
                        CornerRadius="8"
                        Padding="16"
                        Margin="0,8,0,20">
                    <StackPanel Spacing="8">
                        <TextBlock Text="5. Caracterización de Discapacidad o Condición del Alumno"
                                   FontSize="{ThemeResource AppSubHeaderFontSize}"
                                   FontWeight="Bold"
                                   Foreground="{ThemeResource AppAccentBrush}"
                                   TextWrapping="Wrap"
                                   AutomationProperties.HeadingLevel="Level2" />
                        <TextBlock Text="El tutor adaptará automáticamente el lenguaje, los estímulos visuales, la voz y la dificultad según esta selección."
                                   FontSize="{ThemeResource AppBaseFontSize}"
                                   Foreground="{ThemeResource AppTextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,4" />

                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="Condición o Discapacidad (Selección múltiple / Comorbilidad):"
                                           FontSize="{ThemeResource AppBaseFontSize}"
                                           FontWeight="SemiBold"
                                           Foreground="{ThemeResource AppTextPrimaryBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,4"
                                           AutomationProperties.HeadingLevel="Level3" />
                                <CheckBox x:Name="ChkDisabilityVisual"
                                          Content="👁️ Discapacidad Visual (Ceguera o Baja Visión)"
                                          FontSize="{ThemeResource AppBaseFontSize}"
                                          Margin="0,3"
                                          AutomationProperties.Name="Discapacidad Visual, Ceguera o Baja Visión"
                                          Click="ChkDisability_Changed"
                                          GotFocus="Control_GotFocus" />
                                <CheckBox x:Name="ChkDisabilityHearing"
                                          Content="👂 Discapacidad Auditiva (Hipoacusia o Sordera)"
                                          FontSize="{ThemeResource AppBaseFontSize}"
                                          Margin="0,3"
                                          AutomationProperties.Name="Discapacidad Auditiva, Hipoacusia o Sordera"
                                          Click="ChkDisability_Changed"
                                          GotFocus="Control_GotFocus" />
                                <CheckBox x:Name="ChkDisabilityMotor"
                                          Content="🖐️ Discapacidad Motriz (Dificultad motora fina)"
                                          FontSize="{ThemeResource AppBaseFontSize}"
                                          Margin="0,3"
                                          AutomationProperties.Name="Discapacidad Motriz, Dificultad motora fina"
                                          Click="ChkDisability_Changed"
                                          GotFocus="Control_GotFocus" />
                                <CheckBox x:Name="ChkDisabilityIntellectual"
                                          Content="🧠 Discapacidad Intelectual / Cognitiva"
                                          FontSize="{ThemeResource AppBaseFontSize}"
                                          Margin="0,3"
                                          AutomationProperties.Name="Discapacidad Intelectual o Cognitiva"
                                          Click="ChkDisability_Changed"
                                          GotFocus="Control_GotFocus" />
                                <CheckBox x:Name="ChkDisabilityAutism"
                                          Content="🌈 Condición del Espectro Autista"
                                          FontSize="{ThemeResource AppBaseFontSize}"
                                          Margin="0,3"
                                          AutomationProperties.Name="Condición del Espectro Autista"
                                          Click="ChkDisability_Changed"
                                          GotFocus="Control_GotFocus" />
                                <CheckBox x:Name="ChkDisabilityAdhd"
                                          Content="⚡ TDAH (Déficit de Atención e Hiperactividad)"
                                          FontSize="{ThemeResource AppBaseFontSize}"
                                          Margin="0,3"
                                          AutomationProperties.Name="TDAH, Déficit de Atención e Hiperactividad"
                                          Click="ChkDisability_Changed"
                                          GotFocus="Control_GotFocus" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Spacing="8">
                                <TextBlock Text="Apoyos y Descripción Funcional:"
                                           FontSize="{ThemeResource AppBaseFontSize}"
                                           FontWeight="SemiBold"
                                           Foreground="{ThemeResource AppTextPrimaryBrush}"
                                           TextWrapping="Wrap"
                                           AutomationProperties.HeadingLevel="Level3" />
                                <TextBlock Text="Elige el apoyo o la descripción que corresponde a cada condición. No hay un grado único de severidad."
                                           FontSize="{ThemeResource AppBaseFontSize}"
                                           Foreground="{ThemeResource AppTextSecondaryBrush}"
                                           TextWrapping="Wrap" />

                                <StackPanel x:Name="PnlAutismSupport" Spacing="2" Visibility="Collapsed">
                                    <TextBlock Text="Apoyo para autismo:" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <ComboBox x:Name="CmbAutismSupport"
                                              FontSize="{ThemeResource AppBaseFontSize}"
                                              MinHeight="48"
                                              Padding="10,6"
                                              HorizontalAlignment="Stretch"
                                              AutomationProperties.Name="Nivel de apoyo para autismo"
                                              AutomationProperties.HelpText="Presiona Enter o Alt+Flecha Abajo para desplegar opciones y selecciona con las flechas"
                                              SelectionChanged="SupportDescription_Changed"
                                              DropDownClosed="SupportCombo_DropDownClosed"
                                              GotFocus="Control_GotFocus" />
                                </StackPanel>

                                <StackPanel x:Name="PnlAdhdPresentation" Spacing="2" Visibility="Collapsed">
                                    <TextBlock Text="Presentación del TDAH:" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <ComboBox x:Name="CmbAdhdPresentation"
                                              FontSize="{ThemeResource AppBaseFontSize}"
                                              MinHeight="48"
                                              Padding="10,6"
                                              HorizontalAlignment="Stretch"
                                              AutomationProperties.Name="Presentación predominante del TDAH"
                                              AutomationProperties.HelpText="Presiona Enter o Alt+Flecha Abajo para desplegar opciones y selecciona con las flechas"
                                              SelectionChanged="SupportDescription_Changed"
                                              DropDownClosed="SupportCombo_DropDownClosed"
                                              GotFocus="Control_GotFocus" />
                                </StackPanel>

                                <StackPanel x:Name="PnlIntellectualSupport" Spacing="2" Visibility="Collapsed">
                                    <TextBlock Text="Apoyos para discapacidad intelectual:" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <ComboBox x:Name="CmbIntellectualSupport"
                                              FontSize="{ThemeResource AppBaseFontSize}"
                                              MinHeight="48"
                                              Padding="10,6"
                                              HorizontalAlignment="Stretch"
                                              AutomationProperties.Name="Nivel de apoyos para discapacidad intelectual"
                                              AutomationProperties.HelpText="Presiona Enter o Alt+Flecha Abajo para desplegar opciones y selecciona con las flechas"
                                              SelectionChanged="SupportDescription_Changed"
                                              DropDownClosed="SupportCombo_DropDownClosed"
                                              GotFocus="Control_GotFocus" />
                                </StackPanel>

                                <StackPanel x:Name="PnlVisualFunction" Spacing="2" Visibility="Collapsed">
                                    <TextBlock Text="Descripción funcional visual:" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <ComboBox x:Name="CmbVisualFunction"
                                              FontSize="{ThemeResource AppBaseFontSize}"
                                              MinHeight="48"
                                              Padding="10,6"
                                              HorizontalAlignment="Stretch"
                                              AutomationProperties.Name="Descripción funcional de la visión"
                                              AutomationProperties.HelpText="Presiona Enter o Alt+Flecha Abajo para desplegar opciones y selecciona con las flechas"
                                              SelectionChanged="SupportDescription_Changed"
                                              DropDownClosed="SupportCombo_DropDownClosed"
                                              GotFocus="Control_GotFocus" />
                                </StackPanel>

                                <StackPanel x:Name="PnlAuditoryFunction" Spacing="2" Visibility="Collapsed">
                                    <TextBlock Text="Descripción funcional auditiva:" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <ComboBox x:Name="CmbAuditoryFunction"
                                              FontSize="{ThemeResource AppBaseFontSize}"
                                              MinHeight="48"
                                              Padding="10,6"
                                              HorizontalAlignment="Stretch"
                                              AutomationProperties.Name="Descripción funcional de la audición"
                                              AutomationProperties.HelpText="Presiona Enter o Alt+Flecha Abajo para desplegar opciones y selecciona con las flechas"
                                              SelectionChanged="SupportDescription_Changed"
                                              DropDownClosed="SupportCombo_DropDownClosed"
                                              GotFocus="Control_GotFocus" />
                                </StackPanel>

                                <StackPanel x:Name="PnlMotorFunction" Spacing="2" Visibility="Collapsed">
                                    <TextBlock Text="Descripción funcional motriz:" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <ComboBox x:Name="CmbMotorFunction"
                                              FontSize="{ThemeResource AppBaseFontSize}"
                                              MinHeight="48"
                                              Padding="10,6"
                                              HorizontalAlignment="Stretch"
                                              AutomationProperties.Name="Descripción funcional de la motricidad"
                                              AutomationProperties.HelpText="Presiona Enter o Alt+Flecha Abajo para desplegar opciones y selecciona con las flechas"
                                              SelectionChanged="SupportDescription_Changed"
                                              DropDownClosed="SupportCombo_DropDownClosed"
                                              GotFocus="Control_GotFocus" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Opciones Adaptativas Activas:"
                                   FontSize="{ThemeResource AppBaseFontSize}"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource AppTextPrimaryBrush}"
                                   Margin="0,8,0,2"
                                   TextWrapping="Wrap"
                                   AutomationProperties.HeadingLevel="Level3" />

                        <CheckBox x:Name="ChkInternalAudio"
                                  Content="Audio Interno del Juego: efectos y pistas sonoras"
                                  FontSize="{ThemeResource AppBaseFontSize}"
                                  Margin="0,4"
                                  AutomationProperties.Name="Audio interno del juego, efectos y pistas sonoras"
                                  Checked="ChkInternalAudio_Changed"
                                  Unchecked="ChkInternalAudio_Changed"
                                  GotFocus="Control_GotFocus" />

                        <CheckBox x:Name="ChkScreenReaderAnnouncements"
                                  Content="Anuncios para el Lector de Pantalla Externo (NVDA, JAWS o Narrador)"
                                  FontSize="{ThemeResource AppBaseFontSize}"
                                  Margin="0,4"
                                  AutomationProperties.Name="Anuncios para el lector de pantalla externo NVDA, JAWS o Narrador"
                                  Checked="ChkScreenReaderAnnouncements_Changed"
                                  Unchecked="ChkScreenReaderAnnouncements_Changed"
                                  GotFocus="Control_GotFocus" />

                        <CheckBox x:Name="ChkAudioCues"
                                  Content="Pistas Sonoras Musicales y de Orientación (Conteo Armónico)"
                                  FontSize="{ThemeResource AppBaseFontSize}"
                                  Margin="0,4"
                                  AutomationProperties.Name="Pistas Sonoras Musicales y de Orientación"
                                  Checked="ChkAudioCues_Changed"
                                  Unchecked="ChkAudioCues_Changed"
                                  GotFocus="Control_GotFocus" />

                        <CheckBox x:Name="ChkSimplifyLanguage"
                                  Content="Simplificar Lenguaje y Reducir Opciones (Discapacidad Intelectual / Menor Carga Cognitiva)"
                                  FontSize="{ThemeResource AppBaseFontSize}"
                                  Margin="0,4"
                                  AutomationProperties.Name="Simplificar Lenguaje y Reducir Opciones"
                                  Checked="ChkSimplifyLanguage_Changed"
                                  Unchecked="ChkSimplifyLanguage_Changed"
                                  GotFocus="Control_GotFocus" />
                    </StackPanel>
                </Border>

                <Border Background="{ThemeResource AppSurfaceBrush}"
                        BorderBrush="{ThemeResource AppBorderBrush}"
                        BorderThickness="2"
                        CornerRadius="8"
                        Padding="16"
                        Margin="0,0,0,20">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Privacidad y Datos del Alumno"
                                   FontSize="{ThemeResource AppSubHeaderFontSize}"
                                   FontWeight="Bold"
                                   Foreground="{ThemeResource AppAccentBrush}"
                                   TextWrapping="Wrap"
                                   AutomationProperties.HeadingLevel="Level2" />
                        <TextBlock Text="No necesitas dar un diagnóstico para usar MathTutor. Si prefieres no decirlo, deja las condiciones sin marcar y los apoyos en 'Sin especificar'."
                                   FontSize="{ThemeResource AppBaseFontSize}"
                                   Foreground="{ThemeResource AppTextPrimaryBrush}"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="El nombre, la edad, los apoyos y el progreso se guardan solo en este equipo. La aplicación no envía datos a internet ni usa telemetría. Puedes exportar una copia o borrar el perfil cuando quieras."
                                   FontSize="{ThemeResource AppBaseFontSize}"
                                   Foreground="{ThemeResource AppTextSecondaryBrush}"
                                   TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button x:Name="BtnExportProfile"
                                    Content="Exportar perfil y progreso"
                                    Style="{StaticResource AccessibleActionButton}"
                                    FontSize="{ThemeResource AppBaseFontSize}"
                                    MinHeight="48"
                                    AutomationProperties.Name="Exportar perfil y progreso a un archivo"
                                    Click="BtnExportProfile_Click"
                                    GotFocus="Control_GotFocus" />
                            <Button x:Name="BtnDeleteProfile"
                                    Content="Borrar perfil de este equipo"
                                    Style="{StaticResource AccessibleActionButton}"
                                    Background="{ThemeResource AppSurfaceBrush}"
                                    Foreground="{ThemeResource AppTextPrimaryBrush}"
                                    FontSize="{ThemeResource AppBaseFontSize}"
                                    MinHeight="48"
                                    AutomationProperties.Name="Borrar el perfil guardado en este equipo"
                                    Click="BtnDeleteProfile_Click"
                                    GotFocus="Control_GotFocus" />
                            <Button x:Name="BtnPrivacyNotice"
                                    Content="Leer aviso de privacidad"
                                    Style="{StaticResource AccessibleActionButton}"
                                    Background="{ThemeResource AppSurfaceBrush}"
                                    Foreground="{ThemeResource AppTextPrimaryBrush}"
                                    FontSize="{ThemeResource AppBaseFontSize}"
                                    MinHeight="48"
                                    AutomationProperties.Name="Leer el aviso de privacidad"
                                    Click="BtnPrivacyNotice_Click"
                                    GotFocus="Control_GotFocus" />
                        </StackPanel>
                        <TextBlock x:Name="TxtPrivacyStatus"
                                   FontSize="{ThemeResource AppBaseFontSize}"
                                   Foreground="{ThemeResource AppSuccessBrush}"
                                   TextWrapping="Wrap"
                                   AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                </Border>

                <Grid Margin="0,0,0,24" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Text="6. Esquema de Contraste (WCAG)"
                                   FontSize="{ThemeResource AppBaseFontSize}"
                                   FontWeight="Bold"
                                   Foreground="{ThemeResource AppTextPrimaryBrush}"
                                   TextWrapping="Wrap"
                                   AutomationProperties.HeadingLevel="Level2" />
                        <ComboBox x:Name="CmbTheme"
                                  FontSize="{ThemeResource AppBaseFontSize}"
                                  MinHeight="48"
                                  Padding="10,6"
                                  HorizontalAlignment="Stretch"
                                  AutomationProperties.Name="Esquema de contraste accesible"
                                  SelectionChanged="CmbTheme_SelectionChanged"
                                  GotFocus="Control_GotFocus" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock Text="7. Tamaño de Letra"
                                   FontSize="{ThemeResource AppBaseFontSize}"
                                   FontWeight="Bold"
                                   Foreground="{ThemeResource AppTextPrimaryBrush}"
                                   TextWrapping="Wrap"
                                   AutomationProperties.HeadingLevel="Level2" />
                        <ComboBox x:Name="CmbFontSize"
                                  FontSize="{ThemeResource AppBaseFontSize}"
                                  MinHeight="48"
                                  Padding="10,6"
                                  HorizontalAlignment="Stretch"
                                  AutomationProperties.Name="Tamaño de letra del sistema"
                                  SelectionChanged="CmbFontSize_SelectionChanged"
                                  GotFocus="Control_GotFocus" />
                    </StackPanel>
                </Grid>

                <Button x:Name="BtnSaveAndStart"
                        Content="⭐ ¡Guardar Caracterización y Comenzar la Aventura! ⭐"
                        Style="{StaticResource AccessibleActionButton}"
                        FontSize="{ThemeResource AppHeaderFontSize}"
                        MinHeight="64"
                        AutomationProperties.Name="Guardar perfil y comenzar la aventura matemática"
                        AutomationProperties.HelpText="Presiona Enter o Espacio para guardar tu perfil e ir al menú de misiones"
                        Click="BtnSaveAndStart_Click"
                        GotFocus="Control_GotFocus" />

                <Button x:Name="BtnCancel"
                        Content="⬅ Volver al Menú sin Guardar"
                        Style="{StaticResource AccessibleActionButton}"
                        Background="{ThemeResource AppSurfaceBrush}"
                        Foreground="{ThemeResource AppTextPrimaryBrush}"
                        FontSize="{ThemeResource AppBaseFontSize}"
                        MinHeight="56"
                        Margin="0,12,0,0"
                        Visibility="Collapsed"
                        AutomationProperties.Name="Volver al menú sin guardar los cambios"
                        AutomationProperties.HelpText="Descarta los cambios de esta pantalla y regresa al menú de misiones"
                        Click="BtnCancel_Click"
                        GotFocus="Control_GotFocus" />
            </StackPanel>
        </Border>
    </ScrollViewer>
</Page>
