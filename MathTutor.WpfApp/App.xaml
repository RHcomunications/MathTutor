<Application x:Class="MathTutor.WpfApp.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MathTutor.WpfApp"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- Paleta base accesible predeterminada -->
        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F8F9FF"/>
        <SolidColorBrush x:Key="AppSurfaceBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="AppCardBrush" Color="#F0F3FA"/>
        <SolidColorBrush x:Key="AppTextPrimaryBrush" Color="#14192D"/>
        <SolidColorBrush x:Key="AppTextSecondaryBrush" Color="#3C465F"/>
        <SolidColorBrush x:Key="AppAccentBrush" Color="#5A3CDC"/>
        <SolidColorBrush x:Key="AppFocusBorderBrush" Color="#FF7800"/>
        <SolidColorBrush x:Key="AppBorderBrush" Color="#D2DCF0"/>
        <SolidColorBrush x:Key="AppSuccessBrush" Color="#0F8C46"/>
        <SolidColorBrush x:Key="AppOnAccentBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="AppOnSuccessBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="AppErrorBrush" Color="#B00020"/>

        <!-- Escala de tipografía adaptable -->
        <sys:Double x:Key="AppBaseFontSize" xmlns:sys="clr-namespace:System;assembly=mscorlib">18</sys:Double>
        <sys:Double x:Key="AppSubHeaderFontSize" xmlns:sys="clr-namespace:System;assembly=mscorlib">22</sys:Double>
        <sys:Double x:Key="AppHeaderFontSize" xmlns:sys="clr-namespace:System;assembly=mscorlib">28</sys:Double>
        <sys:Double x:Key="AppTitleFontSize" xmlns:sys="clr-namespace:System;assembly=mscorlib">36</sys:Double>

        <!-- Indicador de Foco Visible WCAG 2.4.7 y 2.4.11 -->
        <Style x:Key="AccessibleFocusVisual">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Rectangle Stroke="{DynamicResource AppFocusBorderBrush}"
                                   StrokeThickness="4"
                                   StrokeDashArray="2 1"
                                   Margin="-5"
                                   RadiusX="6"
                                   RadiusY="6"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo accesible para Botones de Acción -->
        <Style x:Key="AccessibleActionButton" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{StaticResource AccessibleFocusVisual}"/>
            <Setter Property="Background" Value="{DynamicResource AppAccentBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppOnAccentBrush}"/>
            <Setter Property="FontSize" Value="{DynamicResource AppBaseFontSize}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="MinHeight" Value="52"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo accesible para Botones de Opción del Minijuego -->
        <Style x:Key="AccessibleGameOptionButton" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{StaticResource AccessibleFocusVisual}"/>
            <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="{DynamicResource AppHeaderFontSize}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="24,18"/>
            <Setter Property="MinHeight" Value="75"/>
            <Setter Property="MinWidth" Value="140"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="3"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource AppAccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource AppFocusBorderBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo para Tarjetas Contenedoras -->
        <Style x:Key="AccessibleCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource AppCardBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="20"/>
        </Style>

        <!-- Estilo para Bloques de Texto Explorables con Cursor del Lector de Pantalla (NVDA / JAWS / Narrador) -->
        <Style x:Key="AccessibleReadOnlyTextBox" TargetType="TextBox">
            <Setter Property="FocusVisualStyle" Value="{StaticResource AccessibleFocusVisual}"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="IsReadOnlyCaretVisible" Value="True"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="2"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="Cursor" Value="Arrow"/>
        </Style>
    </Application.Resources>
</Application>
