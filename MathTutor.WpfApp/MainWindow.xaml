<Window x:Class="MathTutor.WpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MathTutor.WpfApp"
        mc:Ignorable="d"
        Title="Tutor Matemático Accesible - Aprendizaje Lúdico Inclusivo"
        Height="820" Width="1100"
        MinHeight="600" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Barra de Accesibilidad Superior -->
            <RowDefinition Height="*"/>    <!-- Contenido Activo -->
            <RowDefinition Height="Auto"/> <!-- Región en Vivo de Anuncios / Estado -->
        </Grid.RowDefinitions>

        <!-- Barra de Herramientas de Accesibilidad y Control Global (Cumplimiento WCAG 2.2) -->
        <Border Grid.Row="0"
                Background="{DynamicResource AppSurfaceBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="0,0,0,2"
                Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Identidad del Tutor -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🦉" FontSize="30" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="MathTutor Accesible"
                               FontSize="{DynamicResource AppSubHeaderFontSize}"
                               FontWeight="Bold"
                               Foreground="{DynamicResource AppAccentBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Botones de Acceso Rápido / Atajos -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button x:Name="BtnNavMenu"
                            Content="🏠 Menú (Esc)"
                            Style="{StaticResource AccessibleActionButton}"
                            Background="{DynamicResource AppSurfaceBrush}"
                            Foreground="{DynamicResource AppTextPrimaryBrush}"
                            Height="44"
                            Padding="12,6"
                            Margin="4,0"
                            AutomationProperties.Name="Ir al menú principal de aventuras. Tecla Escape"
                            Click="BtnNavMenu_Click"/>

                    <Button x:Name="BtnNavMap"
                            Content="🗺️ Mapa (F6)"
                            Style="{StaticResource AccessibleActionButton}"
                            Background="{DynamicResource AppSurfaceBrush}"
                            Foreground="{DynamicResource AppTextPrimaryBrush}"
                            Height="44"
                            Padding="12,6"
                            Margin="4,0"
                            AutomationProperties.Name="Ir al mapa del reino matemático. Tecla F6"
                            Click="BtnNavMap_Click"/>

                    <Button x:Name="BtnNavProfile"
                            Content="👤 Perfil (F5)"
                            Style="{StaticResource AccessibleActionButton}"
                            Background="{DynamicResource AppSurfaceBrush}"
                            Foreground="{DynamicResource AppTextPrimaryBrush}"
                            Height="44"
                            Padding="12,6"
                            Margin="4,0"
                            AutomationProperties.Name="Ir a la pantalla de perfil y caracterización. Tecla F5"
                            Click="BtnNavProfile_Click"/>

                    <Button x:Name="BtnToggleContrast"
                            Content="🎨 Contraste (F3)"
                            Style="{StaticResource AccessibleActionButton}"
                            Background="{DynamicResource AppSurfaceBrush}"
                            Foreground="{DynamicResource AppTextPrimaryBrush}"
                            Height="44"
                            Padding="12,6"
                            Margin="4,0"
                            AutomationProperties.Name="Cambiar esquema de contraste. Tecla F3"
                            Click="BtnToggleContrast_Click"/>

                    <Button x:Name="BtnToggleFont"
                            Content="🔤 Letra (F4)"
                            Style="{StaticResource AccessibleActionButton}"
                            Background="{DynamicResource AppSurfaceBrush}"
                            Foreground="{DynamicResource AppTextPrimaryBrush}"
                            Height="44"
                            Padding="12,6"
                            Margin="4,0"
                            AutomationProperties.Name="Cambiar tamaño de letra. Tecla F4"
                            Click="BtnToggleFont_Click"/>

                    <Button x:Name="BtnToggleSpeech"
                            Content="🔊 Lector (F2)"
                            Style="{StaticResource AccessibleActionButton}"
                            Background="{DynamicResource AppSurfaceBrush}"
                            Foreground="{DynamicResource AppTextPrimaryBrush}"
                            Height="44"
                            Padding="12,6"
                            Margin="4,0"
                            AutomationProperties.Name="Activar o desactivar anuncios automáticos al lector de pantalla. Tecla F2"
                            Click="BtnToggleSpeech_Click"/>

                    <Button x:Name="BtnHelpVoice"
                            Content="❓ Repetir (F1)"
                            Style="{StaticResource AccessibleActionButton}"
                            Background="{DynamicResource AppSurfaceBrush}"
                            Foreground="{DynamicResource AppTextPrimaryBrush}"
                            Height="44"
                            Padding="12,6"
                            Margin="4,0"
                            AutomationProperties.Name="Repetir última instrucción en el lector de pantalla. Tecla F1"
                            Click="BtnHelpVoice_Click"/>
                </StackPanel>

                <!-- Marcador de Progreso Rápido -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{DynamicResource AppCardBrush}"
                            BorderBrush="{DynamicResource AppBorderBrush}"
                            BorderThickness="2"
                            CornerRadius="8"
                            Padding="10,6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⭐ " FontSize="18" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtTopStars" Text="0"
                                       FontSize="{DynamicResource AppBaseFontSize}"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource AppTextPrimaryBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Anfitrión de Contenido de Pantallas -->
        <ContentControl Grid.Row="1" x:Name="MainContentHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>

        <!-- Barra Inferior de Anuncios Accesibles (Región en Vivo Nativa UIA para NVDA, JAWS y Narrador) -->
        <Border Grid.Row="2"
                Background="{DynamicResource AppCardBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="💬 " FontSize="16" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1"
                           x:Name="TxtLiveAnnouncement"
                           Text="Listo para aprender jugando."
                           FontSize="14"
                           Foreground="{DynamicResource AppTextSecondaryBrush}"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"
                           AutomationProperties.LiveSetting="Assertive"/>
            </Grid>
        </Border>
    </Grid>
</Window>
