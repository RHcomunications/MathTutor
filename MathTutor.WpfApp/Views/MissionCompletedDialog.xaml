<Window x:Class="MathTutor.WpfApp.Views.MissionCompletedDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="¡Felicidades! Misión Completada"
        Width="680"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource AppBackgroundBrush}"
        AutomationProperties.Name="Diálogo de Misión Completada">
    <Border Margin="20"
            Style="{StaticResource AccessibleCard}"
            BorderBrush="{DynamicResource AppSuccessBrush}"
            BorderThickness="4">
        <StackPanel>
            <!-- Encabezado de Celebración -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">
                <TextBlock Text="🏆" FontSize="44" Margin="0,0,12,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtCompletedHeader"
                           Text="¡Felicidades! Misión Completada"
                           FontSize="{DynamicResource AppHeaderFontSize}"
                           FontWeight="Bold"
                           Foreground="{DynamicResource AppSuccessBrush}"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <!-- Mensaje de Felicitación del Tema -->
            <TextBox x:Name="TxtCongratulationMessage"
                     Style="{StaticResource AccessibleReadOnlyTextBox}"
                     Text="¡Has superado todos los retos de esta misión con éxito!"
                     FontSize="{DynamicResource AppSubHeaderFontSize}"
                     Foreground="{DynamicResource AppTextPrimaryBrush}"
                     TextAlignment="Center"
                     Margin="0,0,0,20"
                     AutomationProperties.Name="Mensaje de felicitación de la misión"/>

            <!-- Instrucción de Transición -->
            <TextBlock x:Name="TxtTransitionPrompt"
                       Text="Presiona Enter para jugar la siguiente misión o Escape para volver al Mapa del Reino."
                       FontSize="{DynamicResource AppBaseFontSize}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource AppTextSecondaryBrush}"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Margin="0,0,0,20"/>

            <!-- Botón Primario: Siguiente Misión (Enter) -->
            <Button x:Name="BtnNextMission"
                    Content="Siguiente Misión"
                    IsDefault="True"
                    Style="{StaticResource AccessibleActionButton}"
                    Background="{DynamicResource AppSuccessBrush}"
                    Foreground="#FFFFFF"
                    FontSize="{DynamicResource AppSubHeaderFontSize}"
                    MinHeight="64"
                    Margin="0,0,0,12"
                    AutomationProperties.HelpText="Presiona Enter o Espacio para comenzar la siguiente misión inmediatamente."
                    Click="BtnNextMission_Click"/>

            <!-- Botón Secundario: Volver al Mapa del Reino (Escape) -->
            <Button x:Name="BtnBackToMap"
                    Content="Volver al Mapa del Reino (Escape)"
                    IsCancel="True"
                    Style="{StaticResource AccessibleActionButton}"
                    Background="{DynamicResource AppSurfaceBrush}"
                    Foreground="{DynamicResource AppTextPrimaryBrush}"
                    FontSize="{DynamicResource AppBaseFontSize}"
                    MinHeight="54"
                    AutomationProperties.Name="Volver al Mapa del Reino"
                    AutomationProperties.HelpText="Presiona Escape o Enter sobre este botón para regresar al Mapa del Reino."
                    Click="BtnBackToMap_Click"/>

            <!-- Región en Vivo del Diálogo Modal para NVDA, JAWS y Narrador -->
            <TextBlock x:Name="TxtDialogLiveRegion"
                       Text=""
                       FontSize="12"
                       Foreground="{DynamicResource AppTextSecondaryBrush}"
                       Margin="0,10,0,0"
                       TextTrimming="CharacterEllipsis"
                       AutomationProperties.LiveSetting="Assertive"/>
        </StackPanel>
    </Border>
</Window>
