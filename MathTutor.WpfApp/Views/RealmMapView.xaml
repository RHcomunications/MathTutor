<UserControl x:Class="MathTutor.WpfApp.Views.RealmMapView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="950">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24" MaxWidth="920" HorizontalAlignment="Center">
            <!-- Barra Superior del Mapa -->
            <Border Style="{StaticResource AccessibleCard}" Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="BtnBackToMenu"
                            Content="⬅ Volver al Menú"
                            Style="{StaticResource AccessibleActionButton}"
                            Background="{DynamicResource AppSurfaceBrush}"
                            Foreground="{DynamicResource AppTextPrimaryBrush}"
                            Height="48"
                            MinWidth="140"
                            Margin="0,0,16,0"
                            AutomationProperties.Name="Volver al menú principal de lecciones"
                            Click="BtnBackToMenu_Click"/>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="🗺️ Mapa del Reino Matemágico"
                                   FontSize="{DynamicResource AppHeaderFontSize}"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                        <TextBlock Text="Sigue el sendero, supera las estaciones y colecciona todas las insignias."
                                   FontSize="{DynamicResource AppBaseFontSize}"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}"
                                   Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- Resumen de Trofeos -->
                    <Border Grid.Column="2"
                            Background="{DynamicResource AppSurfaceBrush}"
                            BorderBrush="{DynamicResource AppBorderBrush}"
                            BorderThickness="2"
                            CornerRadius="10"
                            Padding="12,8">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🏅 " FontSize="22" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtBadgesUnlockedCount" Text="0/7"
                                       FontSize="{DynamicResource AppSubHeaderFontSize}"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource AppTextPrimaryBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Título de las Estaciones del Reino -->
            <TextBlock Text="🏰 Estaciones del Sendero de Aventuras (Usa las flechas Arriba/Abajo y Enter):"
                       FontSize="{DynamicResource AppSubHeaderFontSize}"
                       FontWeight="Bold"
                       Foreground="{DynamicResource AppAccentBrush}"
                       Margin="4,0,0,12"/>

            <!-- Tarea 2 y Tarea 3: Lista de Estaciones del Sendero con navegación direccional por flechas -->
            <ListBox x:Name="ItemsStations"
                     Background="Transparent"
                     BorderThickness="0"
                     HorizontalContentAlignment="Stretch"
                     SelectionMode="Single"
                     IsSynchronizedWithCurrentItem="True"
                     KeyboardNavigation.DirectionalNavigation="Cycle"
                     KeyboardNavigation.TabNavigation="Once"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.CanContentScroll="False"
                     AutomationProperties.Name="Lista de estaciones del Mapa del Reino"
                     AutomationProperties.HelpText="Usa las flechas arriba y abajo para cambiar de estación y presiona Enter o Espacio para comenzar."
                     PreviewKeyDown="ItemsStations_PreviewKeyDown"
                     SelectionChanged="ItemsStations_SelectionChanged">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="FocusVisualStyle" Value="{StaticResource AccessibleFocusVisual}"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0,0,0,14"/>
                        <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleActionName}"/>
                        <Setter Property="AutomationProperties.HelpText" Value="Presiona Enter o Espacio para comenzar."/>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource AccessibleCard}"
                                BorderBrush="{DynamicResource AppBorderBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Icono del Monumento -->
                                <Border Grid.Column="0"
                                        Background="{DynamicResource AppSurfaceBrush}"
                                        BorderBrush="{DynamicResource AppBorderBrush}"
                                        BorderThickness="2"
                                        CornerRadius="14"
                                        Width="75"
                                        Height="75"
                                        Margin="0,0,16,0"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding LandmarkEmoji}"
                                               FontSize="36"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>

                                <!-- Información de la Estación -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding StationNumberPrefix}"
                                                   FontSize="{DynamicResource AppBaseFontSize}"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource AppAccentBrush}"
                                                   Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="{DynamicResource AppSubHeaderFontSize}"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                                    </StackPanel>

                                    <TextBlock Text="{Binding Description}"
                                               FontSize="{DynamicResource AppBaseFontSize}"
                                               Foreground="{DynamicResource AppTextSecondaryBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,3,0,6"/>

                                    <!-- Estado de Logro -->
                                    <TextBlock Text="{Binding StatusText}"
                                               FontSize="{DynamicResource AppBaseFontSize}"
                                               FontWeight="SemiBold"
                                               Foreground="{Binding StatusBrush}"/>
                                </StackPanel>

                                <!-- Botón de Entrada a la Misión -->
                                <Button Grid.Column="2"
                                        Content="🚀 Explorar"
                                        Style="{StaticResource AccessibleActionButton}"
                                        VerticalAlignment="Center"
                                        MinWidth="130"
                                        Height="54"
                                        Tag="{Binding TopicId}"
                                        Focusable="False"
                                        IsTabStop="False"
                                        AutomationProperties.Name="{Binding AccessibleActionName}"
                                        AutomationProperties.HelpText="Presiona Enter o Espacio para comenzar."
                                        Click="BtnStation_Click"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Título de la Sala de Trofeos -->
            <TextBlock Text="🏅 Sala de Trofeos e Insignias del Reino:"
                       FontSize="{DynamicResource AppSubHeaderFontSize}"
                       FontWeight="Bold"
                       Foreground="{DynamicResource AppAccentBrush}"
                       Margin="4,16,0,12"/>

            <!-- Cuadrícula / WrapPanel de Insignias -->
            <ItemsControl x:Name="ItemsBadges">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel HorizontalAlignment="Center"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="260"
                                Margin="8"
                                Padding="16"
                                CornerRadius="12"
                                Background="{Binding BadgeBackgroundBrush}"
                                BorderBrush="{Binding BadgeBorderBrush}"
                                BorderThickness="2">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="{Binding IconEmoji}"
                                           FontSize="42"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,6"/>
                                <TextBlock Text="{Binding Title}"
                                           FontSize="{DynamicResource AppBaseFontSize}"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource AppTextPrimaryBrush}"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding Description}"
                                           FontSize="14"
                                           Foreground="{DynamicResource AppTextSecondaryBrush}"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,8"/>
                                <TextBlock Text="{Binding UnlockStatusText}"
                                           FontSize="13"
                                           FontWeight="Bold"
                                           Foreground="{Binding UnlockStatusBrush}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
