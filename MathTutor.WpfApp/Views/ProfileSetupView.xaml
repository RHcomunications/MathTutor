<UserControl x:Class="MathTutor.WpfApp.Views.ProfileSetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="950">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Border Margin="24" Style="{StaticResource AccessibleCard}" MaxWidth="850" HorizontalAlignment="Center">
            <StackPanel Focusable="False">
                <!-- Título y Mascota -->
                <Border Background="{DynamicResource AppSurfaceBrush}"
                        BorderBrush="{DynamicResource AppAccentBrush}"
                        BorderThickness="0,0,0,4"
                        CornerRadius="8"
                        Padding="16"
                        Margin="0,0,0,20">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="🦉" FontSize="48" Margin="0,0,16,0" VerticalAlignment="Center" Focusable="False"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="¡Bienvenido a la Aventura de las Matemáticas!"
                                       FontSize="{DynamicResource AppHeaderFontSize}"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource AppTextPrimaryBrush}"
                                       TextWrapping="Wrap"/>
                            <TextBlock Text="Caracterización del Alumno y Configuración de Accesibilidad"
                                       FontSize="{DynamicResource AppBaseFontSize}"
                                       Foreground="{DynamicResource AppTextSecondaryBrush}"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Campo: Nombre o Apodo -->
                <TextBlock Text="1. ¿Cómo te llamas o cómo quieres que te llame Cosmo?"
                           FontSize="{DynamicResource AppBaseFontSize}"
                           FontWeight="Bold"
                           Foreground="{DynamicResource AppTextPrimaryBrush}"
                           Margin="0,8,0,4"/>
                <TextBox x:Name="TxtName"
                         Text="Aventurero Matemático"
                         FontSize="{DynamicResource AppBaseFontSize}"
                         Padding="12,8"
                         MinHeight="48"
                         AutomationProperties.Name="Nombre o apodo del alumno"
                         AutomationProperties.HelpText="Escribe tu nombre para personalizar los juegos"
                         BorderThickness="2"
                         BorderBrush="{DynamicResource AppBorderBrush}"
                         Margin="0,0,0,16"
                         GotFocus="Control_GotFocus"/>

                <!-- Campo: Edad y Nivel Académico -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="2. Edad del Alumno"
                                   FontSize="{DynamicResource AppBaseFontSize}"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource AppTextPrimaryBrush}"
                                   Margin="0,0,0,4"/>
                        <ComboBox x:Name="CmbAge"
                                  FontSize="{DynamicResource AppBaseFontSize}"
                                  MinHeight="48"
                                  Padding="10,6"
                                  AutomationProperties.Name="Edad del alumno en años"
                                  SelectionChanged="CmbAge_SelectionChanged"
                                  GotFocus="Control_GotFocus"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="3. Nivel Escolar Inicial"
                                   FontSize="{DynamicResource AppBaseFontSize}"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource AppTextPrimaryBrush}"
                                   Margin="0,0,0,4"/>
                        <ComboBox x:Name="CmbAcademicLevel"
                                  FontSize="{DynamicResource AppBaseFontSize}"
                                  MinHeight="48"
                                  Padding="10,6"
                                  AutomationProperties.Name="Nivel escolar inicial"
                                  SelectionChanged="CmbAcademicLevel_SelectionChanged"
                                  GotFocus="Control_GotFocus"/>
                    </StackPanel>
                </Grid>

                <!-- Campo: País y Contexto Cultural (Latinoamérica) -->
                <StackPanel Margin="0,0,0,16">
                    <TextBlock Text="3b. País y Moneda (Adaptación Cultural de Ejemplos)"
                               FontSize="{DynamicResource AppBaseFontSize}"
                               FontWeight="Bold"
                               Foreground="{DynamicResource AppTextPrimaryBrush}"
                               Margin="0,0,0,4"/>
                    <ComboBox x:Name="CmbRegion"
                              FontSize="{DynamicResource AppBaseFontSize}"
                              MinHeight="48"
                              Padding="10,6"
                              AutomationProperties.Name="País y adaptación cultural de moneda y vocabulario"
                              SelectionChanged="CmbRegion_SelectionChanged"
                              GotFocus="Control_GotFocus"/>
                </StackPanel>

                <!-- Sección: Caracterización de Discapacidad -->
                <Border Background="{DynamicResource AppSurfaceBrush}"
                        BorderBrush="{DynamicResource AppBorderBrush}"
                        BorderThickness="2"
                        CornerRadius="8"
                        Padding="16"
                        Margin="0,8,0,20">
                    <StackPanel>
                        <TextBlock Text="4. Caracterización de Discapacidad o Condición del Alumno"
                                   FontSize="{DynamicResource AppSubHeaderFontSize}"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource AppAccentBrush}"
                                   Margin="0,0,0,8"/>
                        <TextBlock Text="El tutor adaptará automáticamente el lenguaje, los estímulos visuales, la voz y la dificultad según esta selección."
                                   FontSize="{DynamicResource AppBaseFontSize}"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,12"/>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Tipo de Discapacidad:"
                                           FontSize="{DynamicResource AppBaseFontSize}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource AppTextPrimaryBrush}"
                                           Margin="0,0,0,4"/>
                                <ComboBox x:Name="CmbDisabilityType"
                                          FontSize="{DynamicResource AppBaseFontSize}"
                                          MinHeight="48"
                                          Padding="10,6"
                                          AutomationProperties.Name="Tipo de discapacidad presentada"
                                          SelectionChanged="CmbDisabilityType_SelectionChanged"
                                          GotFocus="Control_GotFocus"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Grado / Severidad:"
                                           FontSize="{DynamicResource AppBaseFontSize}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource AppTextPrimaryBrush}"
                                           Margin="0,0,0,4"/>
                                <ComboBox x:Name="CmbDisabilitySeverity"
                                          FontSize="{DynamicResource AppBaseFontSize}"
                                          MinHeight="48"
                                          Padding="10,6"
                                          AutomationProperties.Name="Grado o severidad de la discapacidad"
                                          SelectionChanged="CmbDisabilitySeverity_SelectionChanged"
                                          GotFocus="Control_GotFocus"/>
                            </StackPanel>
                        </Grid>

                        <!-- Preferencias automáticas adaptadas -->
                        <TextBlock Text="Opciones Adaptativas Activas:"
                                   FontSize="{DynamicResource AppBaseFontSize}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AppTextPrimaryBrush}"
                                   Margin="0,8,0,6"/>

                        <CheckBox x:Name="ChkVoiceSynthesis"
                                  Content="Habilitar Anuncios Automáticos para Lector de Pantalla (NVDA, JAWS o Narrador)"
                                  FontSize="{DynamicResource AppBaseFontSize}"
                                  Margin="0,4"
                                  AutomationProperties.Name="Habilitar anuncios automáticos para el lector de pantalla del sistema"
                                  Checked="ChkVoiceSynthesis_Changed"
                                  Unchecked="ChkVoiceSynthesis_Changed"
                                  GotFocus="Control_GotFocus"/>

                        <CheckBox x:Name="ChkAudioCues"
                                  Content="Pistas Sonoras Musicales y de Orientación (Conteo Armónico)"
                                  FontSize="{DynamicResource AppBaseFontSize}"
                                  Margin="0,4"
                                  AutomationProperties.Name="Pistas Sonoras Musicales y de Orientación"
                                  Checked="ChkAudioCues_Changed"
                                  Unchecked="ChkAudioCues_Changed"
                                  GotFocus="Control_GotFocus"/>

                        <CheckBox x:Name="ChkSimplifyLanguage"
                                  Content="Simplificar Lenguaje y Reducir Opciones (Discapacidad Intelectual / Menor Carga Cognitiva)"
                                  FontSize="{DynamicResource AppBaseFontSize}"
                                  Margin="0,4"
                                  AutomationProperties.Name="Simplificar Lenguaje y Reducir Opciones"
                                  Checked="ChkSimplifyLanguage_Changed"
                                  Unchecked="ChkSimplifyLanguage_Changed"
                                  GotFocus="Control_GotFocus"/>
                    </StackPanel>
                </Border>

                <!-- Personalización Visual Accesible -->
                <Grid Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="5. Esquema de Contraste (WCAG)"
                                   FontSize="{DynamicResource AppBaseFontSize}"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource AppTextPrimaryBrush}"
                                   Margin="0,0,0,4"/>
                        <ComboBox x:Name="CmbTheme"
                                  FontSize="{DynamicResource AppBaseFontSize}"
                                  MinHeight="48"
                                  Padding="10,6"
                                  AutomationProperties.Name="Esquema de contraste accesible"
                                  SelectionChanged="CmbTheme_SelectionChanged"
                                  GotFocus="Control_GotFocus"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="6. Tamaño de Letra"
                                   FontSize="{DynamicResource AppBaseFontSize}"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource AppTextPrimaryBrush}"
                                   Margin="0,0,0,4"/>
                        <ComboBox x:Name="CmbFontSize"
                                  FontSize="{DynamicResource AppBaseFontSize}"
                                  MinHeight="48"
                                  Padding="10,6"
                                  AutomationProperties.Name="Tamaño de letra del sistema"
                                  SelectionChanged="CmbFontSize_SelectionChanged"
                                  GotFocus="Control_GotFocus"/>
                    </StackPanel>
                </Grid>

                <!-- Botón de Inicio con Foco Principal -->
                <Button x:Name="BtnSaveAndStart"
                        Content="⭐ ¡Guardar Caracterización y Comenzar la Aventura! ⭐"
                        Style="{StaticResource AccessibleActionButton}"
                        FontSize="{DynamicResource AppHeaderFontSize}"
                        Height="64"
                        AutomationProperties.Name="Guardar perfil y comenzar la aventura matemática"
                        AutomationProperties.HelpText="Presiona Enter o Espacio para guardar tu perfil e ir al menú de misiones"
                        Click="BtnSaveAndStart_Click"
                        GotFocus="Control_GotFocus"/>
            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>
