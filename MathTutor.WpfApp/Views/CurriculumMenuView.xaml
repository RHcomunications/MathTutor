<UserControl x:Class="MathTutor.WpfApp.Views.CurriculumMenuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="950">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24" MaxWidth="900" HorizontalAlignment="Center">
            <!-- Barra Superior de Progreso Lúdico -->
            <Border Style="{StaticResource AccessibleCard}" Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtWelcomeUser"
                                   Text="¡Hola, Aventurero! Elige tu próxima misión"
                                   FontSize="{DynamicResource AppHeaderFontSize}"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource AppTextPrimaryBrush}"
                                   TextWrapping="Wrap"/>
                        <TextBlock x:Name="TxtUserSummary"
                                   Text="Nivel actual: Jardín de Niños"
                                   FontSize="{DynamicResource AppBaseFontSize}"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}"
                                   Margin="0,4,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                        <!-- Contador de Estrellas -->
                        <Border Background="{DynamicResource AppSurfaceBrush}"
                                BorderBrush="{DynamicResource AppBorderBrush}"
                                BorderThickness="2"
                                CornerRadius="10"
                                Padding="12,8"
                                Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⭐" FontSize="26" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock x:Name="TxtStarsCount" Text="0"
                                           FontSize="{DynamicResource AppSubHeaderFontSize}"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource AppTextPrimaryBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Contador de Racha -->
                        <Border Background="{DynamicResource AppSurfaceBrush}"
                                BorderBrush="{DynamicResource AppBorderBrush}"
                                BorderThickness="2"
                                CornerRadius="10"
                                Padding="12,8"
                                Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔥" FontSize="26" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock x:Name="TxtStreakCount" Text="0"
                                           FontSize="{DynamicResource AppSubHeaderFontSize}"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource AppTextPrimaryBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Botón Mapa Mágico -->
                        <Button x:Name="BtnOpenRealmMap"
                                Content="🗺️ Ver Mapa"
                                Style="{StaticResource AccessibleActionButton}"
                                Background="{DynamicResource AppSurfaceBrush}"
                                Foreground="{DynamicResource AppTextPrimaryBrush}"
                                Height="48"
                                Padding="12,6"
                                AutomationProperties.Name="Abrir el mapa del reino matemático y ver tus trofeos"
                                Click="BtnOpenRealmMap_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Título de Selección de Misión -->
            <TextBlock Text="Misiones de Aprendizaje Disponibles:"
                       FontSize="{DynamicResource AppSubHeaderFontSize}"
                       FontWeight="Bold"
                       Foreground="{DynamicResource AppAccentBrush}"
                       Margin="4,0,0,12"/>

            <!-- Contenedor dinámico de temas -->
            <ItemsControl x:Name="ItemsTopics">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource AccessibleCard}"
                                Margin="0,0,0,16"
                                BorderBrush="{DynamicResource AppBorderBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                    <TextBlock Text="{Binding StatusBadgeText}"
                                               FontSize="{DynamicResource AppBaseFontSize}"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource AppAccentBrush}"
                                               Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding Title}"
                                               FontSize="{DynamicResource AppSubHeaderFontSize}"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource AppTextPrimaryBrush}"
                                               TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding LevelDescription}"
                                               FontSize="{DynamicResource AppBaseFontSize}"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource AppAccentBrush}"
                                               Margin="0,4,0,6"/>
                                    <TextBlock Text="{Binding ConceptSnippet}"
                                               FontSize="{DynamicResource AppBaseFontSize}"
                                               Foreground="{DynamicResource AppTextSecondaryBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,8"/>
                                    <!-- Principios -->
                                    <TextBlock Text="{Binding PrinciplesSnippet}"
                                               FontSize="{DynamicResource AppBaseFontSize}"
                                               Foreground="{DynamicResource AppTextPrimaryBrush}"
                                               FontStyle="Italic"
                                               TextWrapping="Wrap"/>
                                </StackPanel>

                                <Button Grid.Column="1"
                                        Content="{Binding ActionButtonLabel}"
                                        Style="{StaticResource AccessibleActionButton}"
                                        VerticalAlignment="Center"
                                        MinWidth="160"
                                        Height="60"
                                        Tag="{Binding TopicId}"
                                        AutomationProperties.Name="{Binding AccessibleButtonName}"
                                        AutomationProperties.HelpText="Presiona para iniciar esta lección lúdica"
                                        Click="BtnEnterTopic_Click"
                                        GotFocus="Button_GotFocus"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
