<UserControl x:Class="MathTutor.WpfApp.Views.LessonView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="950"
             Focusable="True"
             PreviewKeyDown="LessonView_PreviewKeyDown">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24" MaxWidth="850" HorizontalAlignment="Center">
            <!-- Barra Superior: Botón Volver, Título de la Lección e Indicador Stepper -->
            <Border Style="{StaticResource AccessibleCard}" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="BtnBackToMenu"
                            Content="⬅ Menú"
                            Style="{StaticResource AccessibleActionButton}"
                            Background="{DynamicResource AppSurfaceBrush}"
                            Foreground="{DynamicResource AppTextPrimaryBrush}"
                            Height="48"
                            MinWidth="100"
                            Margin="0,0,16,0"
                            AutomationProperties.Name="Volver al menú de aventuras"
                            Click="BtnBackToMenu_Click"/>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtLessonTitle"
                                   Text="Título de la Lección"
                                   FontSize="{DynamicResource AppHeaderFontSize}"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource AppTextPrimaryBrush}"
                                   TextWrapping="Wrap"/>
                        <TextBlock x:Name="TxtStepIndicator"
                                   Text="Paso 1 de 3: Historia de la Misión"
                                   FontSize="{DynamicResource AppBaseFontSize}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AppAccentBrush}"
                                   Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- Banner de Atajo Rápido -->
                    <Border Grid.Column="2"
                            Background="{DynamicResource AppSurfaceBrush}"
                            BorderBrush="{DynamicResource AppBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12,6"
                            VerticalAlignment="Center">
                        <TextBlock Text="Enter: Avanzar | Flechas: Retroceder"
                                   FontSize="{DynamicResource AppBaseFontSize}"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                    </Border>
                </Grid>
            </Border>

            <!-- ============================================== -->
            <!-- TARJETA PASO 1: HISTORIA Y NARRATIVA CON COSMO -->
            <!-- ============================================== -->
            <Border x:Name="CardStep1"
                    Background="{DynamicResource AppSurfaceBrush}"
                    BorderBrush="{DynamicResource AppAccentBrush}"
                    BorderThickness="3"
                    CornerRadius="16"
                    Padding="24"
                    Margin="0,0,0,20"
                    Visibility="Visible">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Avatar del Tutor -->
                    <Border Grid.Column="0"
                            Background="{DynamicResource AppCardBrush}"
                            BorderBrush="{DynamicResource AppAccentBrush}"
                            BorderThickness="2"
                            CornerRadius="20"
                            Width="110"
                            Height="110"
                            Margin="0,0,20,0"
                            VerticalAlignment="Top">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="🦉" FontSize="50" HorizontalAlignment="Center"/>
                            <TextBlock Text="Cosmo" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource AppAccentBrush}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Contenido Narrativo -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <Border Background="{DynamicResource AppCardBrush}"
                                CornerRadius="6"
                                Padding="8,4"
                                HorizontalAlignment="Left"
                                Margin="0,0,0,8">
                            <TextBlock Text="📖 PASO 1 DE 3: HISTORIA DE LA MISIÓN"
                                       FontSize="{DynamicResource AppBaseFontSize}"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource AppAccentBrush}"/>
                        </Border>
                        <TextBox x:Name="TxtNarrativeStory"
                                 Style="{StaticResource AccessibleReadOnlyTextBox}"
                                 Text="Historia introductoria de Cosmo..."
                                 FontSize="{DynamicResource AppSubHeaderFontSize}"
                                 Foreground="{DynamicResource AppTextPrimaryBrush}"
                                 Margin="0,0,0,12"
                                 AutomationProperties.Name="Historia de la Misión"/>
                        <TextBlock Text="👉 Presiona Enter o Espacio para continuar al Secreto Matemático."
                                   FontSize="{DynamicResource AppBaseFontSize}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AppAccentBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ======================================================= -->
            <!-- TARJETA PASO 2: EL SECRETO MATEMÁTICO Y SUS PRINCIPIOS -->
            <!-- ======================================================= -->
            <Border x:Name="CardStep2"
                    Background="{DynamicResource AppCardBrush}"
                    BorderBrush="{DynamicResource AppAccentBrush}"
                    BorderThickness="3"
                    CornerRadius="16"
                    Padding="24"
                    Margin="0,0,0,20"
                    Visibility="Collapsed">
                <StackPanel>
                    <Border Background="{DynamicResource AppSurfaceBrush}"
                            CornerRadius="6"
                            Padding="8,4"
                            HorizontalAlignment="Left"
                            Margin="0,0,0,10">
                        <TextBlock Text="✨ PASO 2 DE 3: EL SECRETO MATEMÁTICO"
                                   FontSize="{DynamicResource AppBaseFontSize}"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource AppAccentBrush}"/>
                    </Border>

                    <TextBox x:Name="TxtCoreConcept"
                             Style="{StaticResource AccessibleReadOnlyTextBox}"
                             Text="Explicación del concepto..."
                             FontSize="{DynamicResource AppSubHeaderFontSize}"
                             Foreground="{DynamicResource AppTextPrimaryBrush}"
                             Margin="0,0,0,16"
                             AutomationProperties.Name="Explicación del Secreto Matemático"/>

                    <TextBlock Text="Principios que dominarás en este juego:"
                               FontSize="{DynamicResource AppBaseFontSize}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AppTextSecondaryBrush}"
                               Margin="0,0,0,6"/>
                    <ItemsControl x:Name="ItemsPrinciples" Margin="0,0,0,12">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource AppSurfaceBrush}"
                                        BorderBrush="{DynamicResource AppBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="10,6"
                                        Margin="0,3">
                                    <TextBlock Text="{Binding}"
                                               FontSize="{DynamicResource AppBaseFontSize}"
                                               Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="👉 Presiona Enter o Espacio para ver el Ejemplo Guiado, o Flecha Izquierda para volver a la Historia."
                               FontSize="{DynamicResource AppBaseFontSize}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AppAccentBrush}"/>
                </StackPanel>
            </Border>

            <!-- ============================================== -->
            <!-- TARJETA PASO 3: EJEMPLO GUIADO Y TRANSICIÓN -->
            <!-- ============================================== -->
            <Border x:Name="CardStep3"
                    Background="{DynamicResource AppSurfaceBrush}"
                    BorderBrush="{DynamicResource AppAccentBrush}"
                    BorderThickness="3"
                    CornerRadius="16"
                    Padding="24"
                    Margin="0,0,0,20"
                    Visibility="Collapsed">
                <StackPanel>
                    <Border Background="{DynamicResource AppCardBrush}"
                            CornerRadius="6"
                            Padding="8,4"
                            HorizontalAlignment="Left"
                            Margin="0,0,0,10">
                        <TextBlock Text="📝 PASO 3 DE 3: EJEMPLO GUIADO PASO A PASO"
                                   FontSize="{DynamicResource AppBaseFontSize}"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource AppAccentBrush}"/>
                    </Border>

                    <TextBox x:Name="TxtGuidedExample"
                             Style="{StaticResource AccessibleReadOnlyTextBox}"
                             Text="Ejemplo resuelto paso a paso..."
                             FontSize="{DynamicResource AppBaseFontSize}"
                             Foreground="{DynamicResource AppTextPrimaryBrush}"
                             Margin="0,0,0,16"
                             AutomationProperties.Name="Ejemplo Guiado Paso a Paso con Cosmo"/>

                    <TextBlock Text="🎉 ¡Has completado la lección preparatoria! Presiona Enter para iniciar el reto lúdico o Flecha Izquierda para repasar."
                               FontSize="{DynamicResource AppBaseFontSize}"
                               FontWeight="Bold"
                               Foreground="{DynamicResource AppAccentBrush}"/>
                </StackPanel>
            </Border>

            <!-- ============================================== -->
            <!-- BOTONES DE ACCIÓN ACCESIBLES DEL STEPPER -->
            <!-- ============================================== -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        x:Name="BtnPreviousStep"
                        Content="⬅ Anterior"
                        Style="{StaticResource AccessibleActionButton}"
                        Background="{DynamicResource AppSurfaceBrush}"
                        Foreground="{DynamicResource AppTextPrimaryBrush}"
                        Height="64"
                        FontSize="{DynamicResource AppSubHeaderFontSize}"
                        AutomationProperties.Name="Volver al paso anterior de la lección"
                        IsEnabled="False"
                        Click="BtnPreviousStep_Click"/>

                <Button Grid.Column="2"
                        x:Name="BtnRepeatVoice"
                        Content="🔊 Escuchar Paso (F1)"
                        Style="{StaticResource AccessibleActionButton}"
                        Background="{DynamicResource AppSurfaceBrush}"
                        Foreground="{DynamicResource AppTextPrimaryBrush}"
                        Height="64"
                        FontSize="{DynamicResource AppSubHeaderFontSize}"
                        AutomationProperties.Name="Escuchar la explicación del paso actual"
                        Click="BtnRepeatVoice_Click"/>

                <Button Grid.Column="4"
                        x:Name="BtnNextOrStart"
                        Content="➡ Siguiente Paso (Enter)"
                        IsDefault="True"
                        Style="{StaticResource AccessibleActionButton}"
                        Height="64"
                        FontSize="{DynamicResource AppSubHeaderFontSize}"
                        AutomationProperties.Name="Avanzar al siguiente paso de la lección"
                        Click="BtnNextOrStart_Click"/>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
